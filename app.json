{
    "name": "DriveTelegramUploader",
    "description": "Telegram bot to upload Google Drive videos.",
    "keywords": [
      "telegram",
      "bot",
      "gdrive",
      "python"
    ],
    "repository": "https://github.com/ITsGOLU-OFFICIAL/ITsGOLU_UPLOADER_FAST-V2",
    "stack": "container",
    "env": {
      "API_ID": {
        "description": "Get this value from my.telegram.org",
        "required": true
      },
      "API_HASH": {
        "description": "Get this value from my.telegram.org",
        "required": true
      },
      "BOT_TOKEN": {
        "description": "The bot token from BotFather",
        "required": true
      },
      "OWNER_ID": {
        "description": "Your Telegram User ID",
        "required": true
      },
      "GDRIVE_CREDENTIALS": {
        "description": "JSON string for Google Service Account credentials",
        "required": true
      },
      "CREDIT": {
        "description": "Caption credit for your uploads",
        "required": false,
        "value": "𝐈𝐓'𝐬𝐆𝐎𝐋𝐔"
      }
    },
    "buildpacks": [
      {
        "url": "heroku/python"
      },
      {
        "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest.git"
      }
    ]
  }